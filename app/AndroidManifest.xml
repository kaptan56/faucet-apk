<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- İnternet İzni -->
    <uses-permission android:name="android.permission.INTERNET" />
    
    <!-- Diğer Uygulamaların Üzerinde Gösterme İzni (Yüzen Sayaç İçin) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- Ön Plan Servisi İzni -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    
    <!-- Bildirim İzni (Android 13+ için) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="BilgilerBurda Faucet"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FaucetApp">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FaucetApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Yüzen Sayaç Servisimiz -->
        <service 
            android:name=".FloatingTimerService" 
            android:exported="false" />

    </application>

</manifest>
